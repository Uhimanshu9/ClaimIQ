# Provider credentials are consumed by the LiteLLM Proxy service.
# Do not expose these keys to the browser or commit real values.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI credential used by LiteLLM when OpenAI aliases are enabled
OPENAI_API_KEY=your_openai_api_key_here

# AWS configuration used by LiteLLM for the Bedrock alias
AWS_REGION=us-east-1

# LiteLLM Proxy Configuration
LITELLM_BASE_URL=http://litellm:4000
# For this simple single-app deployment, use the same key as the proxy master
# key. Replace LITELLM_API_KEY with a LiteLLM virtual key when key management
# is enabled.
LITELLM_API_KEY=sk-claimiq-master
LITELLM_MASTER_KEY=sk-claimiq-master
LITELLM_GEMINI_MODEL=claimiq-chat-gemini
LITELLM_OPENAI_MODEL=claimiq-chat-openai
LITELLM_BEDROCK_MODEL=claimiq-chat-bedrock
LITELLM_GEMINI_EMBEDDING_MODEL=claimiq-embedding-gemini
LITELLM_OPENAI_EMBEDDING_MODEL=claimiq-embedding-openai

# Keep this provider unchanged for an existing Qdrant collection. This project's
# OpenAI migration uses a new collection, so documents must be uploaded again.
VECTOR_EMBEDDING_PROVIDER=openai
VECTOR_DIMENSIONS=1536
QDRANT_COLLECTION=pdf_collection_openai_small
QDRANT_URL=http://qdrant:6333

# MongoDB Configuration (for production)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# Application Configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1
