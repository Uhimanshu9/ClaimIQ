# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI Configuration (required only when provider=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Amazon Bedrock Configuration (required only for POST /bedrock/query)
AWS_REGION=us-east-1
BEDROCK_MODEL=amazon.nova-lite-v1:0

# Keep this provider unchanged for an existing Qdrant collection. This project's
# OpenAI migration uses a new collection, so documents must be uploaded again.
VECTOR_EMBEDDING_PROVIDER=openai
QDRANT_COLLECTION=pdf_collection_openai_small
QDRANT_URL=http://qdrant:6333

# MongoDB Configuration (for production)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# Application Configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1
